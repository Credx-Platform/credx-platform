{
  "name": "credx-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "if [ -n \"$SKIP_PRISMA_GENERATE\" ]; then echo 'Skipping prisma generate'; else npm run prisma:generate; fi",
    "dev": "npm run dev --workspace @credx/api",
    "build": "npm run build:api && npm run build:web",
    "build:api": "node scripts/check-node-crypto-imports.mjs && npm run build --workspace @credx/api",
    "build:web": "npm run build --workspace @credx/web",
    "test:readiness": "node --import tsx --test apps/api/tests/readinessScore.test.ts",
    "test": "node --import tsx --test apps/api/tests/*.test.ts",
    "test:integration": "node --import tsx --test apps/api/tests/*.integration.test.ts",
    "test:web": "npm run build:web && node --test apps/web/tests/*.test.mjs",
    "start": "npm run start:api",
    "start:api": "npm run start --workspace @credx/api",
    "start:worker": "npm run start:worker --workspace @credx/api",
    "dev:worker": "npm run dev:worker --workspace @credx/api",
    "start:web": "npm run start --workspace @credx/web",
    "prisma:generate": "npm run prisma:generate --workspace @credx/db",
    "prisma:migrate": "node scripts/guarded-prisma.mjs migrate-dev",
    "db:migrate:deploy": "node scripts/guarded-prisma.mjs migrate-deploy",
    "db:migrate:status": "node scripts/guarded-prisma.mjs migrate-status",
    "db:schema:push:disposable": "node scripts/guarded-prisma.mjs db-push",
    "db:safety:check": "node scripts/check-db-safety.mjs",
    "test:db-safety": "node --test scripts/tests/db-safety.test.mjs",
    "analysis:reprocess": "node scripts/reprocess-credit-report.mjs",
    "cron:readiness-snapshots": "node scripts/credx-ops-cron.mjs readiness-snapshots",
    "cron:weekly-checkins": "node scripts/credx-ops-cron.mjs weekly-checkins",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "imapflow": "^1.4.6"
  }
}
