# Classification is mandatory. The guard fails closed when it is absent.
CREDX_DATABASE_ENVIRONMENT=staging

# Staging must have its own Postgres instance. Never copy the production URL.
DATABASE_URL=postgresql://credx_staging:replace-me@staging-db.example:5432/credx_staging
TEST_DATABASE_URL=postgresql://credx_staging:replace-me@staging-db.example:5432/credx_staging_test

# Only set this for a database explicitly confirmed to be disposable.
CREDX_ALLOW_DESTRUCTIVE=DISPOSABLE_DATABASE_CONFIRMED

# Set to the production target fingerprint so a mislabeled production URL is blocked.
CREDX_PRODUCTION_DATABASE_FINGERPRINT=replace-with-production-fingerprint
